 <objectgroup id="5" name="Objects">
  <object id="38" template="../../obj/entry_up.tx" x="320" y="528" />
  <object id="60" template="../../obj/dialog.tx" x="272" y="192">
   <properties>
    <property name="cosDialogKey" value="pool.eva" />
    <property name="dialog" value="[{&quot;text&quot;:&quot;Madam Eva holds a place beside the fire. \&quot;You have come ahead of the person you promised to protect. Go to Barovia. Let Ireena choose the journey, and make the old road safe for her.\&quot;&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosEscortAccepted&quot;,&quot;not&quot;:true}]},{&quot;text&quot;:&quot;\&quot;The road has teeth yet,\&quot; Eva says. \&quot;A campfire is not proof that your crossing is safe. Face the pack on the Old Svalich Road, then return with Ireena.\&quot;&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosEscortAccepted&quot;},{&quot;checkQuestFlag&quot;:&quot;cosRoadCleared&quot;,&quot;not&quot;:true}]},{&quot;text&quot;:&quot;Eva studies you and Ireena across the fire. \&quot;You have brought her this far. Before you rest, will you hear what the valley asks of those who would leave it?\&quot;&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Hear Eva's warning and finish this chapter.&quot;,&quot;text&quot;:&quot;\&quot;Do not mistake distance for freedom. Learn whom you can trust before you seek the count's house.\&quot; Eva folds her hands. No reading is dealt tonight. Ireena is sheltered, and this opening chapter ends at Tser Pool. The wider journey is still to come.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;action&quot;:[{&quot;setQuestFlag&quot;:{&quot;key&quot;:&quot;cosChapterOneComplete&quot;,&quot;val&quot;:1}}]},{&quot;name&quot;:&quot;I will return to hear it.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosEscortAccepted&quot;},{&quot;checkQuestFlag&quot;:&quot;cosRoadCleared&quot;},{&quot;checkQuestFlag&quot;:&quot;cosChapterOneComplete&quot;,&quot;not&quot;:true}]},{&quot;text&quot;:&quot;Eva tends the fire. \&quot;The warning is yours to keep. Tonight, rest.\&quot; You have completed Into the Mists. Future journeys beyond this camp are not yet part of this test chapter.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosChapterOneComplete&quot;}]}]" />
    <property name="hidden" type="bool" value="false" />
    <property name="sprite" value="sprites/heroes/human_f.atlas" />
   </properties>
  </object>
  <object id="61" template="../../obj/dialog.tx" x="320" y="368">
   <properties>
    <property name="cosDialogKey" value="pool.ireena" />
    <property name="dialog" value="[{&quot;text&quot;:&quot;The place by the fire is empty. Ireena is still in Barovia. Speak to Ismark, resolve the church, and ask her to travel.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosEscortAccepted&quot;,&quot;not&quot;:true}]},{&quot;text&quot;:&quot;Ireena watches the tree line. \&quot;We still owe the road an answer. Let us deal with the wolves before we settle here.\&quot;&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosEscortAccepted&quot;},{&quot;checkQuestFlag&quot;:&quot;cosRoadCleared&quot;,&quot;not&quot;:true}]},{&quot;text&quot;:&quot;Ireena warms her hands. \&quot;You left Donavich a hard watch, but you did not leave him alone. Thank you for walking with me. Eva is waiting.\&quot;&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosEscortAccepted&quot;},{&quot;checkQuestFlag&quot;:&quot;cosRoadCleared&quot;},{&quot;getCharacterFlag&quot;:{&quot;key&quot;:&quot;cosDoruFate&quot;,&quot;op&quot;:&quot;=&quot;,&quot;val&quot;:1}}]},{&quot;text&quot;:&quot;Ireena warms her hands. \&quot;Donavich will need people around him after what happened. I will remember that when we can return. Thank you for getting us here. Eva is waiting.\&quot;&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosEscortAccepted&quot;},{&quot;checkQuestFlag&quot;:&quot;cosRoadCleared&quot;},{&quot;getCharacterFlag&quot;:{&quot;key&quot;:&quot;cosDoruFate&quot;,&quot;op&quot;:&quot;=&quot;,&quot;val&quot;:2}}]}]" />
    <property name="hidden" type="bool" value="false" />
    <property name="sprite" value="sprites/heroes/human_f.atlas" />
   </properties>
  </object>
  <object id="62" template="../../obj/dialog.tx" x="160" y="448">
   <properties>
    <property name="cosDialogKey" value="pool.sign" />
    <property name="dialog" value="[{&quot;text&quot;:&quot;WESTWARD ROAD\nOther settlements lie beyond the mists. This opening chapter ends at Tser Pool: speak to Madam Eva after escorting Ireena and clearing the pack. Later regions are not yet playable. You may return to Barovia to recover or practice.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}]}]" />
    <property name="hidden" type="bool" value="false" />
   </properties>
  </object>
