    <property name="cosDialogKey" value="west.ambush" />
    <property name="dialog" value="[{&quot;text&quot;:&quot;Hear Madam Eva's warning at Tser Pool after bringing Ireena safely along the old road.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosChapterOneComplete&quot;,&quot;not&quot;:true}]},{&quot;text&quot;:&quot;The causeway narrows between black pools. A wolf pads into the road; others wait behind it. Ireena braces beside the marker. Break the ambush before approaching Vallaki together.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Break the western ambush.&quot;,&quot;action&quot;:[{&quot;battleWithActorID&quot;:-1}]},{&quot;name&quot;:&quot;Withdraw and prepare.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosChapterOneComplete&quot;},{&quot;checkQuestFlag&quot;:&quot;cosWestRoadCleared&quot;,&quot;not&quot;:true}]},{&quot;text&quot;:&quot;The causeway is quiet. Speak to the gatekeeper in Vallaki; the walls are visible through the trees.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosChapterOneComplete&quot;},{&quot;checkQuestFlag&quot;:&quot;cosWestRoadCleared&quot;}]}]" />
