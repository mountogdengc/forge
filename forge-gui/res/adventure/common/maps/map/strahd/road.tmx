   </properties>
  </object>
  <object id="61" template="../../obj/dialog.tx" x="192" y="432">
   <properties>
    <property name="cosDialogKey" value="road.waystone" />
    <property name="dialog" value="[{&quot;text&quot;:&quot;A weathered stone points toward Tser Pool. Someone has scratched a second message beneath the arrow: KEEP WALKING WHEN THE WOODS GO QUIET.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Remember the way.&quot;,&quot;text&quot;:&quot;You note the turn toward camp. A sign can show the route; it cannot clear the wolves.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;action&quot;:[{&quot;setQuestFlag&quot;:{&quot;key&quot;:&quot;cosWaystoneRead&quot;,&quot;val&quot;:1}}]},{&quot;name&quot;:&quot;Leave the stone.&quot;}]}]" />
    <property name="hidden" type="bool" value="false" />
   </properties>
  </object>
  <object id="62" template="../../obj/dialog.tx" x="464" y="160">
   <properties>
    <property name="cosDialogKey" value="road.strahd" />
    <property name="dialog" value="[{&quot;text&quot;:&quot;A rider waits beyond the trees, too still to have arrived by accident. \&quot;You have begun to make choices in my valley,\&quot; he says. \&quot;Do keep making them.\&quot; He turns his horse before you can answer. This is no battlefield, and the count offers no duel.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Keep to the road.&quot;,&quot;action&quot;:[{&quot;setQuestFlag&quot;:{&quot;key&quot;:&quot;cosStrahdDeparted&quot;,&quot;val&quot;:1},&quot;departMapObject&quot;:{&quot;id&quot;:-1,&quot;deltaX&quot;:256,&quot;deltaY&quot;:160,&quot;duration&quot;:2.5,&quot;mountSprite&quot;:&quot;sprites/enemy/beast/horse/horseblack.atlas&quot;}}]}]}]" />
    <property name="hidden" type="bool" value="false" />
