  <object id="60" template="../../obj/enemy.tx" x="288" y="288">
   <properties>
    <property name="cosDialogKey" value="road.wolves" />
    <property name="dialog" value="[{&quot;text&quot;:&quot;Shapes move between the trees. Without Ireena's agreement to travel, there is no reason to force this crossing. Return to the village and speak to her after resolving the church.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosEscortAccepted&quot;,&quot;not&quot;:true}]},{&quot;text&quot;:&quot;The pack fans across the track. Ireena draws back to the waystone. Break their line so you can reach Tser Pool together.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Drive off the pack.&quot;,&quot;action&quot;:[{&quot;battleWithActorID&quot;:-1}]},{&quot;name&quot;:&quot;Retreat and recover.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosEscortAccepted&quot;},{&quot;checkQuestFlag&quot;:&quot;cosRoadCleared&quot;,&quot;not&quot;:true}]},{&quot;text&quot;:&quot;Only pawprints remain. The road to Tser Pool is open. Speak to Madam Eva there to finish this leg of the journey.&quot;,&quot;options&quot;:[{&quot;name&quot;:&quot;Continue.&quot;}],&quot;condition&quot;:[{&quot;checkQuestFlag&quot;:&quot;cosEscortAccepted&quot;},{&quot;checkQuestFlag&quot;:&quot;cosRoadCleared&quot;}]}]" />
    <property name="enemy" value="Mist-Stalked Pack" />
    <property name="defeatDialog" value="[{&quot;text&quot;:&quot;&quot;,&quot;options&quot;:[],&quot;action&quot;:[{&quot;setQuestFlag&quot;:{&quot;key&quot;:&quot;cosRoadCleared&quot;,&quot;val&quot;:1},&quot;deleteMapObject&quot;:-1}]}]" />
